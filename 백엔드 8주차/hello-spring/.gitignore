# =========================
# 기본 Java & Spring Boot .gitignore
# =========================

# 빌드 결과물 (자동 생성)
build/
.gradle/
out/
bin/
!**/src/main/**/build/
!**/src/test/**/build/

# IDE 설정 파일
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.settings/
.apt_generated
.factorypath
.springBeans
.sts4-cache

# 로그 및 OS 파일
*.log
.DS_Store
Thumbs.db

# NetBeans 관련
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# gradle wrapper (중요! -> 실제 프로젝트 실행에 필요함)
!gradle/wrapper/gradle-wrapper.jar

# =========================
# 허용할 것 (프로젝트 소스)
# =========================
!**/src/**
!build.gradle
!settings.gradle
!gradlew
!gradlew.bat
!.gitignore
